diff -ru a/hammer/synthesis/yosys/__init__.py b/hammer/synthesis/yosys/__init__.py
--- a/hammer/synthesis/yosys/__init__.py
+++ b/hammer/synthesis/yosys/__init__.py
@@ -269,8 +269,17 @@
 
         # Technology mapping of flip-flops
         """)
-        for liberty_file in self.liberty_files_tt.split():
-            self.verbose_append(f"dfflibmap -map-only -liberty {liberty_file}")
+        # The first liberty is the standard-cell library. It must NOT get
+        # -map-only: sky130 has no synchronous-reset or enable flop, so yosys
+        # has to synthesise those from what exists, and -map-only forbids
+        # exactly that. Newer yosys infers $_SDFFE_*/$_SDFFCE_* far more
+        # eagerly than the 0.27 this plugin was written against, so with
+        # -map-only thousands survive to the netlist and P&R then dies with
+        # "LEF master $_SDFFE_PP0P_ not found". The IO pad libraries carry no
+        # flops, so they keep -map-only.
+        for i, liberty_file in enumerate(self.liberty_files_tt.split()):
+            flags = "" if i == 0 else "-map-only "
+            self.verbose_append(f"dfflibmap {flags}-liberty {liberty_file}")
         self.verbose_append("opt")
 
         self.write_sdc_file()
